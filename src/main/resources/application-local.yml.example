# 로컬 실행용 설정 - 이 파일을 application-local.yml 로 복사해서 사용 (application-local.yml 은 gitignore)
# 준비: docker compose up -d  (PostgreSQL, 호스트 포트 5455)
# 실행: ./gradlew bootRun  → http://localhost:8095/swagger-ui/index.html
# 시작할 때마다 테이블을 새로 만들고 db/seed-local.sql 시드를 넣음 (로컬 전용, 운영 프로필과 무관)
server:
  port: 8095

spring:
  datasource:
    url: jdbc:postgresql://localhost:5455/eureka
    username: eureka
    password: eureka1234
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: create
    defer-datasource-initialization: true
    show-sql: false
  sql:
    init:
      mode: always
      data-locations: classpath:db/seed-local.sql
      encoding: UTF-8

jwt:
  # JwtTokenProvider 가 Base64 디코딩함 - 로컬 전용 값 (openssl rand -base64 48 로 새로 만들어도 됨)
  secret: 3JCNVYlgb6eO+lFTRnshAnDoq77f00PTNwzu0kXyFs1gASKGTZO9IaXm7P/JbjhQ
  access-token-expiry: 1800000
  refresh-token-expiry: 1209600000

# 로컬엔 S3 가 없어서 이미지 업로드는 실패함 (나머지 API 는 동작)
cloud:
  aws:
    credentials:
      access-key: local-dummy
      secret-key: local-dummy
    region:
      static: ap-northeast-2
    s3:
      bucket: eureka-local-dummy
